    {
      "name": "5. Appointments & Booking Engine",
      "item": [
        {
          "name": "Book Appointment (Conflict Check)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"doctor_id\": 1,\n  \"department_id\": 1,\n  \"appointment_date\": \"2026-09-25\",\n  \"appointment_time\": \"10:00:00\",\n  \"reason\": \"Comprehensive cardiac health checkup\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/appointments",
              "host": ["{{baseUrl}}"],
              "path": ["appointments"]
            }
          }
        },
        {
          "name": "Get All Appointments",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/appointments?status=Confirmed",
              "host": ["{{baseUrl}}"],
              "path": ["appointments"],
              "query": [
                { "key": "status", "value": "Confirmed" }
              ]
            }
          }
        },
        {
          "name": "Update Appointment Status & Notes (Doctor/Admin)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Completed\",\n  \"consultation_notes\": \"Patient examined. Resting blood pressure 120/80. Heart sounds normal.\",\n  \"prescription\": \"Continue standard multivitamin daily and annual follow-up in 12 months.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/appointments/1/status",
              "host": ["{{baseUrl}}"],
              "path": ["appointments", "1", "status"]
            }
          }
        },
        {
          "name": "Cancel Appointment",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/appointments/1/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["appointments", "1", "cancel"]
            }
          }
        }
      ]
    },
