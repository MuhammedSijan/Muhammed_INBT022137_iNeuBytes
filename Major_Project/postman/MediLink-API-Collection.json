              "raw": "{\n  \"name\": \"Ophthalmology\",\n  \"code\": \"OPHT-07\",\n  \"icon\": \"eye\",\n  \"description\": \"Advanced retinal imaging, laser vision correction, and pediatric eye care.\",\n  \"head_doctor\": \"Dr. Robert Vance\"\n}"
