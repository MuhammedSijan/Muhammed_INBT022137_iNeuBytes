{
  "info": {
    "_postman_id": "a233c33e-87a2-4fa9-9cc3-4a8db9c3df7d-medilink",
    "name": "MediLink Healthcare Management API Collection",
    "description": "Comprehensive REST API Collection for MediLink Healthcare & Clinic Management System (iNeuBytes Major Project). Includes Authentication, Role-Based Access Control, Doctor/Patient/Department CRUD, Appointment Booking Engine, and Analytics Reports.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication & Users",
      "item": [
        {
          "name": "Register New Patient",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Alexander Wright\",\n  \"email\": \"alex.wright@example.com\",\n  \"phone\": \"+1 (555) 012-9900\",\n  \"password\": \"Password@123\",\n  \"confirm_password\": \"Password@123\",\n  \"role\": \"patient\",\n  \"gender\": \"Male\",\n  \"blood_group\": \"O+\",\n  \"address\": \"55 Elm Street, Portland, OR\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Login Admin",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@medilink.com\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Login Doctor",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"dr.sarah@medilink.com\",\n  \"password\": \"Doctor@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Login Patient",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john.doe@medilink.com\",\n  \"password\": \"Patient@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Get Current User Profile (/me)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          }
        },
        {
          "name": "Update User Profile",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Johnathan Doe\",\n  \"phone\": \"+1 (555) 012-3456\",\n  \"gender\": \"Male\",\n  \"blood_group\": \"O+\",\n  \"address\": \"742 Evergreen Terrace, Springfield, OR\",\n  \"emergency_contact\": \"+1 (555) 998-1122 (Jane Doe)\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/profile",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "profile"]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Doctors Module",
      "item": [
        {
          "name": "Get All Doctors (with filters)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/doctors?department_id=1&search=sarah",
              "host": ["{{baseUrl}}"],
              "path": ["doctors"],
              "query": [
                { "key": "department_id", "value": "1" },
                { "key": "search", "value": "sarah" }
              ]
            }
          }
        },
        {
          "name": "Get Doctor by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/doctors/1",
              "host": ["{{baseUrl}}"],
              "path": ["doctors", "1"]
            }
          }
        },
        {
          "name": "Get Doctor Available Slots for Date",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/doctors/1/availability?date=2026-09-15",
              "host": ["{{baseUrl}}"],
              "path": ["doctors", "1", "availability"],
              "query": [
                { "key": "date", "value": "2026-09-15" }
              ]
            }
          }
        },
        {
          "name": "Create Doctor (Admin Only)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Dr. Alan Turing\",\n  \"email\": \"dr.alan@medilink.com\",\n  \"phone\": \"+1 (555) 019-3322\",\n  \"department_id\": 2,\n  \"specialization\": \"Cognitive Neurophysiologist\",\n  \"experience_years\": 8,\n  \"consultation_fee\": 85.00,\n  \"room_number\": \"Wing B - 402\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/doctors",
              "host": ["{{baseUrl}}"],
              "path": ["doctors"]
            }
          }
        },
        {
          "name": "Update Doctor Profile",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"consultation_fee\": 95.00,\n  \"bio\": \"Updated physician biography with additional clinical certifications.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/doctors/1",
              "host": ["{{baseUrl}}"],
              "path": ["doctors", "1"]
            }
          }
        },
        {
          "name": "Delete Doctor (Admin Only)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/doctors/6",
              "host": ["{{baseUrl}}"],
              "path": ["doctors", "6"]
            }
          }
        }
      ]
    },
